# OpenRouter configuration
# If you use OpenRouter directly, set the API key and model here.
# If you run a proxy, set VITE_OPENROUTER_PROXY to your proxy URL and leave VITE_OPENROUTER_KEY empty.

# OpenRouter API key (keep secret, do not commit real keys)
VITE_OPENROUTER_KEY=

# OpenRouter model to use (default: openai/gpt-4o-mini)
VITE_OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional proxy URL to avoid exposing the key to the browser
# Example: http://localhost:3000/openrouter
VITE_OPENROUTER_PROXY=
