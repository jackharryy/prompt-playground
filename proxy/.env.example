# Copy to .env and add your OpenRouter key and Google OAuth creds for SSO
OPENROUTER_KEY=
PORT=8787

# Google OAuth (for sign-in)
# Create credentials in Google Cloud Console and set these values.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: override redirect (defaults to http://localhost:8787/auth/google/callback)
#OAUTH_REDIRECT=
